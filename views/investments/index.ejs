<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('../partials/head') %></head>
<body>
<div class="app-layout">
  <%- include('../partials/nav') %>

  <div class="main-content">
    <header class="topbar">
      <div class="topbar-title">Investimentos</div>

      <form id="filterForm" action="/investments" method="GET" style="display:flex; align-items:center; gap:8px; flex-wrap:wrap">
        <select name="type" class="form-control" style="width:auto" onchange="this.form.submit()">
          <option value="all"             <%= filterType === 'all'             ? 'selected' : '' %>>Todos os tipos</option>
          <option value="fixed_income"    <%= filterType === 'fixed_income'    ? 'selected' : '' %>>Renda Fixa</option>
          <option value="variable_income" <%= filterType === 'variable_income' ? 'selected' : '' %>>Renda Variável</option>
        </select>
        <select name="status" class="form-control" style="width:auto" onchange="this.form.submit()">
          <option value="active"   <%= filterStatus === 'active'   ? 'selected' : '' %>>Ativos</option>
          <option value="redeemed" <%= filterStatus === 'redeemed' ? 'selected' : '' %>>Resgatados</option>
          <option value="all"      <%= filterStatus === 'all'      ? 'selected' : '' %>>Todos os status</option>
        </select>
      </form>

      <a href="/investments/new" class="btn btn-primary btn-sm">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Novo Investimento
      </a>
    </header>

    <main class="page-content">

      <!-- Summary Cards -->
      <div class="summary-grid inv-summary-grid">
        <div class="summary-card income">
          <div class="sc-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
            </svg>
          </div>
          <div class="sc-label">Total Investido</div>
          <div class="sc-amount">R$ <%= summary.totalInvested.toLocaleString('pt-BR', {minimumFractionDigits:2}) %></div>
          <div class="sc-sub"><%= summary.fixedCount %> renda fixa · <%= summary.varCount %> renda variável</div>
        </div>

        <div class="summary-card balance">
          <div class="sc-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>
            </svg>
          </div>
          <div class="sc-label">Valor Atual</div>
          <div class="sc-amount">R$ <%= summary.totalCurrent.toLocaleString('pt-BR', {minimumFractionDigits:2}) %></div>
          <div class="sc-sub">carteira ativa</div>
        </div>

        <div class="summary-card <%= summary.totalGain >= 0 ? 'income' : 'expense' %>">
          <div class="sc-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <% if (summary.totalGain >= 0) { %>
                <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>
              <% } else { %>
                <polyline points="23 18 13.5 8.5 8.5 13.5 1 6"/><polyline points="17 18 23 18 23 12"/>
              <% } %>
            </svg>
          </div>
          <div class="sc-label">Rendimento Total</div>
          <div class="sc-amount" style="color: <%= summary.totalGain >= 0 ? 'var(--income)' : 'var(--expense)' %>">
            <%= summary.totalGain >= 0 ? '+' : '' %>R$ <%= summary.totalGain.toLocaleString('pt-BR', {minimumFractionDigits:2}) %>
          </div>
          <div class="sc-sub">
            <%= summary.totalGainPct >= 0 ? '+' : '' %><%= summary.totalGainPct.toFixed(2) %>% no total
          </div>
        </div>
      </div>

      <!-- Investments Table -->
      <div class="card">
        <div class="section-header mb-4">
          <div>
            <div class="section-title">Carteira de Investimentos</div>
            <div class="section-sub">
              <%= investments.length %> ativo<%= investments.length !== 1 ? 's' : '' %> encontrado<%= investments.length !== 1 ? 's' : '' %>
            </div>
          </div>
        </div>

        <% if (investments.length > 0) { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Nome / Ticker</th>
                <th>Tipo</th>
                <th>Corretora</th>
                <th>Aplicado</th>
                <th>Valor Atual</th>
                <th>Rendimento</th>
                <th>Vencimento / Atualização</th>
                <th>Status</th>
                <th>Ações</th>
              </tr>
            </thead>
            <tbody>
              <% investments.forEach(inv => {
                const isFixed = inv.type === 'fixed_income';
                const gainColor = inv.gain >= 0 ? 'var(--income)' : 'var(--expense)';
              %>
              <tr>
                <td>
                  <div style="display:flex; flex-direction:column; gap:2px">
                    <span style="font-weight:600"><%= inv.name %></span>
                    <% if (inv.ticker) { %>
                      <span class="inv-ticker"><%= inv.ticker %></span>
                    <% } %>
                    <% if (inv.category_name) { %>
                      <span style="font-size:11px; color:var(--text-muted)"><%= inv.category_icon %> <%= inv.category_name %></span>
                    <% } %>
                  </div>
                </td>
                <td>
                  <% if (isFixed) { %>
                    <span class="badge inv-badge-fixed">Renda Fixa</span>
                    <% if (inv.rate_type) { %>
                      <div style="font-size:11px; color:var(--text-muted); margin-top:3px">
                        <%
                          const rateLabels = {pre:'Pré-fixado', pos_cdi:'% CDI', pos_ipca:'IPCA+', pos_selic:'Selic+'};
                          const suffix = inv.rate_type === 'pre' ? '% a.a.' : (inv.rate_type === 'pos_cdi' ? '% do CDI' : '% a.a.');
                        %>
                        <%= inv.rate_value %><%= suffix %>
                      </div>
                    <% } %>
                  <% } else { %>
                    <span class="badge inv-badge-var">Renda Variável</span>
                    <% if (inv.asset_class) { %>
                      <%
                        const classLabels = {stock:'Ações', fii:'FII', etf:'ETF', crypto:'Cripto', other:'Outro'};
                      %>
                      <div style="font-size:11px; color:var(--text-muted); margin-top:3px"><%= classLabels[inv.asset_class] || inv.asset_class %></div>
                    <% } %>
                  <% } %>
                </td>
                <td class="text-muted-c"><%= inv.broker || '—' %></td>
                <td>R$ <%= inv.invested_amount.toLocaleString('pt-BR', {minimumFractionDigits:2}) %></td>
                <td>
                  <span style="font-weight:600">R$ <%= inv.computed_current.toLocaleString('pt-BR', {minimumFractionDigits:2}) %></span>
                  <% if (!isFixed && inv.quantity && inv.current_price) { %>
                    <div style="font-size:11px; color:var(--text-muted)">
                      <%= inv.quantity %> × R$ <%= inv.current_price.toLocaleString('pt-BR', {minimumFractionDigits:2}) %>
                    </div>
                  <% } %>
                </td>
                <td>
                  <span style="font-weight:700; color:<%= gainColor %>">
                    <%= inv.gain >= 0 ? '+' : '' %>R$ <%= inv.gain.toLocaleString('pt-BR', {minimumFractionDigits:2}) %>
                  </span>
                  <div style="font-size:11px; color:<%= gainColor %>">
                    <%= inv.gain_pct >= 0 ? '+' : '' %><%= inv.gain_pct.toFixed(2) %>%
                  </div>
                </td>
                <td class="text-muted-c" style="font-size:12px">
                  <% if (isFixed && inv.maturity_date) { %>
                    Vence <%= new Date(inv.maturity_date + 'T12:00:00').toLocaleDateString('pt-BR') %>
                    <% if (inv.is_liquid) { %><div style="color:var(--income); font-size:11px">Liquidez diária</div><% } %>
                  <% } else if (!isFixed && inv.last_updated_at) { %>
                    Atualizado <%= new Date(inv.last_updated_at + 'T12:00:00').toLocaleDateString('pt-BR') %>
                  <% } else { %>
                    —
                  <% } %>
                </td>
                <td>
                  <span class="badge <%= inv.status === 'active' ? 'badge-paid' : 'badge-cancelled' %>">
                    <%= inv.status === 'active' ? 'Ativo' : 'Resgatado' %>
                  </span>
                </td>
                <td>
                  <div class="action-btns">
                    <!-- Quick price update modal trigger -->
                    <button class="btn btn-ghost btn-xs" title="Atualizar valor"
                      onclick="openPriceModal(<%= inv.id %>, '<%= inv.type %>', <%= inv.current_price || inv.current_amount || '' %>)">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                      </svg>
                    </button>
                    <a href="/investments/<%= inv.id %>/edit" class="btn btn-ghost btn-xs" title="Editar">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
                      </svg>
                    </a>
                    <% if (inv.status === 'active') { %>
                      <form method="POST" action="/investments/<%= inv.id %>/redeem" style="display:inline" onsubmit="return confirm('Marcar como resgatado?')">
                        <button type="submit" class="btn btn-ghost btn-xs" title="Resgatar" style="color:var(--expense)">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
                          </svg>
                        </button>
                      </form>
                    <% } else { %>
                      <form method="POST" action="/investments/<%= inv.id %>/reopen" style="display:inline">
                        <button type="submit" class="btn btn-ghost btn-xs" title="Reativar" style="color:var(--income)">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.29"/>
                          </svg>
                        </button>
                      </form>
                    <% } %>
                    <form method="POST" action="/investments/<%= inv.id %>/delete" style="display:inline" onsubmit="return confirm('Excluir investimento permanentemente?')">
                      <button type="submit" class="btn btn-ghost btn-xs" title="Excluir" style="color:var(--expense)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/>
                        </svg>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } else { %>
        <div class="empty-state">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>
          </svg>
          <h3>Nenhum investimento encontrado</h3>
          <p>Comece registrando seu primeiro investimento.</p>
          <a href="/investments/new" class="btn btn-primary btn-sm">Novo Investimento</a>
        </div>
        <% } %>
      </div>

    </main>
  </div>
</div>

<!-- Quick Price Update Modal -->
<div id="priceModal" class="modal-overlay" style="display:none" onclick="if(event.target===this)closePriceModal()">
  <div class="modal-box" style="max-width:380px">
    <div class="modal-header">
      <div class="modal-title">Atualizar Valor</div>
      <button class="modal-close" onclick="closePriceModal()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <form id="priceForm" method="POST">
      <div class="form-group">
        <label id="priceLabel" class="form-label">Preço atual (R$)</label>
        <input type="number" id="priceInput" name="current_price" class="form-control" step="0.01" min="0" placeholder="0,00" required>
      </div>
      <div style="display:flex; gap:8px; justify-content:flex-end; margin-top:16px">
        <button type="button" class="btn btn-ghost btn-sm" onclick="closePriceModal()">Cancelar</button>
        <button type="submit" class="btn btn-primary btn-sm">Salvar</button>
      </div>
    </form>
  </div>
</div>

<script src="/js/investments.js"></script>
</body>
</html>
