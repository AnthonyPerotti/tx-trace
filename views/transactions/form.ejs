<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('../partials/head') %></head>
<body>
<div class="app-layout">
  <%- include('../partials/nav') %>

  <div class="main-content">
    <header class="topbar">
      <div class="topbar-title"><%= transaction && transaction.id ? 'Editar Transação' : 'Nova Transação' %></div>
      <a href="/transactions" class="btn btn-ghost btn-sm">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
          <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
        </svg>
        Voltar
      </a>
    </header>

    <main class="page-content">
      <% const isEdit = transaction && transaction.id; %>
      <% const formAction = isEdit ? `/transactions/${transaction.id}/update` : '/transactions'; %>

      <% if (error) { %>
      <div class="alert alert-error">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
        </svg>
        <%= error %>
      </div>
      <% } %>

      <form action="<%= formAction %>" method="POST" id="txForm">
        <div class="form-row" style="max-width:900px">

          <!-- Left column -->
          <div style="display:flex; flex-direction:column; gap:16px">

            <!-- Type -->
            <div class="card card-sm">
              <div class="form-label" style="margin-bottom:10px">Tipo de Lançamento</div>
              <input type="hidden" name="type" id="typeInput" value="<%= transaction ? transaction.type || 'expense' : 'expense' %>">
              <div class="type-toggle">
                <button type="button" class="type-btn income  <%= (!transaction || transaction.type !== 'income')  ? '' : 'active' %>" onclick="setType('income')">
                  ↑ Receita
                </button>
                <button type="button" class="type-btn expense <%= (!transaction || transaction.type === 'expense' || !transaction.type) ? 'active' : '' %>" onclick="setType('expense')">
                  ↓ Despesa
                </button>
              </div>
            </div>

            <!-- Description + Amount -->
            <div class="card card-sm">
              <div class="form-group">
                <label class="form-label" for="description">Descrição</label>
                <input id="description" name="description" type="text" class="form-control"
                       placeholder="Ex: Almoço no restaurante..."
                       value="<%= transaction ? transaction.description || '' : '' %>" required>
              </div>
              <div class="form-row">
                <div class="form-group" style="margin-bottom:0">
                  <label class="form-label" for="amount">Valor (R$)</label>
                  <input id="amount" name="amount" type="number" class="form-control"
                         placeholder="0,00" step="0.01" min="0.01"
                         value="<%= transaction ? transaction.amount || '' : '' %>" required>
                </div>
                <div class="form-group" style="margin-bottom:0">
                  <label class="form-label" for="transaction_date">Data</label>
                  <input id="transaction_date" name="transaction_date" type="date" class="form-control"
                         value="<%= transaction ? transaction.transaction_date || today : today %>">
                </div>
              </div>
            </div>

            <!-- Category -->
            <div class="card card-sm">
              <div class="form-group" style="margin-bottom:0">
                <label class="form-label" for="category_id">Categoria</label>
                <select id="category_id" name="category_id" class="form-control">
                  <option value="">Sem categoria</option>
                  <% categories.forEach(cat => { %>
                    <option value="<%= cat.id %>"
                      <%= (transaction && transaction.category_id == cat.id) ? 'selected' : '' %>>
                      <%= cat.icon %> <%= cat.name %>
                    </option>
                  <% }) %>
                </select>
              </div>
            </div>

            <!-- Payment Method -->
            <div class="card card-sm">
              <div class="form-label" style="margin-bottom:10px">Forma de Pagamento</div>
              <input type="hidden" name="payment_method" id="paymentMethodInput"
                     value="<%= transaction ? transaction.payment_method || 'pix' : 'pix' %>">
              <div class="method-grid">
                <button type="button" class="method-btn <%= (!transaction || transaction.payment_method === 'debit') ? '' : '' %>"
                        id="btn-debit" onclick="setMethod('debit')">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="18" height="18" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/>
                  </svg>
                  Débito
                </button>
                <button type="button" class="method-btn" id="btn-credit" onclick="setMethod('credit')">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="18" height="18" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/>
                    <line x1="6" y1="16" x2="6.01" y2="16" stroke-width="3"/><line x1="10" y1="16" x2="14" y2="16"/>
                  </svg>
                  Crédito
                </button>
                <button type="button" class="method-btn" id="btn-pix" onclick="setMethod('pix')">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="18" height="18" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
                  </svg>
                  Pix
                </button>
                <button type="button" class="method-btn" id="btn-cash" onclick="setMethod('cash')">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="18" height="18" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                  </svg>
                  Dinheiro
                </button>
              </div>
            </div>

          </div>

          <!-- Right column -->
          <div style="display:flex; flex-direction:column; gap:16px">

            <!-- Institution -->
            <div class="card card-sm" id="instCard" style="border-left: 3px solid transparent; transition: border-color var(--t);">
              <div class="form-group" style="margin-bottom:0">
                <div style="display:flex; justify-content:space-between; align-items:center">
                  <label class="form-label" for="institution_id" style="margin-bottom:0">Conta / Instituição</label>
                  <span id="instTypeBadge" class="text-xs" style="font-weight:600; color:var(--text-muted)"></span>
                </div>
                <div style="display:flex; align-items:center; gap:8px; margin-top:6px">
                  <span id="instColorIndicator" style="width:12px; height:38px; border-radius:4px; background:var(--border-default); flex-shrink:0; transition:background var(--t);"></span>
                  <select id="institution_id" name="institution_id" class="form-control" style="margin-top:0" onchange="updateInstitutionVisual()">
                    <option value="" data-type="" data-color="">Sem conta específica</option>
                    <% institutions.forEach(inst => { 
                      const typeLabel = inst.type === 'credit_card' ? 'Cartão de Crédito' : inst.type === 'bank' ? 'Banco / Conta Corrente' : 'Conta Digital';
                    %>
                      <option value="<%= inst.id %>"
                              data-type="<%= inst.type %>"
                              data-color="<%= inst.color %>"
                              data-type-label="<%= typeLabel %>"
                              <%= (transaction && transaction.institution_id == inst.id) ? 'selected' : '' %>>
                        <%= inst.name %> (<%= typeLabel %>)
                      </option>
                    <% }) %>
                  </select>
                </div>
                <div class="form-hint">
                  <a href="/settings" style="color:var(--primary); font-size:11px">+ Adicionar conta em Configurações</a>
                </div>
              </div>
            </div>

            <!-- Status -->
            <div class="card card-sm">
              <div class="form-label" style="margin-bottom:10px">Status</div>
              <label class="toggle-group">
                <input type="checkbox" name="is_paid" id="isPaid" class="toggle-input"
                       <%= (transaction && transaction.is_paid) ? 'checked' : '' %>>
                <div class="toggle-track"></div>
                <span class="toggle-label">Conta já paga / recebida</span>
              </label>
            </div>

            <!-- Recurring (only for non-edit, non-installment) -->
            <% if (!isEdit) { %>
            <div class="card card-sm" id="recurringSection">
              <div class="form-label" style="margin-bottom:10px">Recorrência</div>
              <label class="toggle-group">
                <input type="checkbox" name="is_recurring" id="isRecurring" class="toggle-input">
                <div class="toggle-track"></div>
                <span class="toggle-label" id="recurringLabel">Despesa recorrente mensal</span>
              </label>
              <div class="form-hint" style="margin-top:6px">A transação será replicada automaticamente todo mês.</div>
            </div>

            <!-- Installments (only for non-edit) -->
            <div class="card card-sm" id="installmentSection">
              <div class="form-label" style="margin-bottom:10px">Parcelamento</div>
              <label class="toggle-group" style="margin-bottom:10px">
                <input type="checkbox" name="is_installment" id="isInstallment" class="toggle-input">
                <div class="toggle-track"></div>
                <span class="toggle-label">Compra parcelada no crédito</span>
              </label>

              <div id="installmentFields" class="hidden">
                <div class="form-row">
                  <div class="form-group" style="margin-bottom:0">
                    <label class="form-label" for="total_installments">Nº de parcelas</label>
                    <input id="total_installments" name="total_installments" type="number"
                           class="form-control" min="2" max="60" value="2" placeholder="Ex: 12">
                  </div>
                  <div class="form-group" style="margin-bottom:0">
                    <label class="form-label" for="first_installment_date">Data 1ª parcela</label>
                    <input id="first_installment_date" name="first_installment_date" type="date"
                           class="form-control" value="<%= today %>">
                  </div>
                </div>
                <div class="form-hint">
                  O valor será dividido igualmente entre as parcelas, criadas automaticamente mês a mês.
                </div>
              </div>
            </div>
            <% } %>

            <!-- Submit -->
            <div style="display:flex; gap:8px">
              <a href="/transactions" class="btn btn-ghost" style="flex:1; justify-content:center">Cancelar</a>
              <button type="submit" class="btn btn-primary" style="flex:2; justify-content:center">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                <%= isEdit ? 'Salvar alterações' : 'Criar lançamento' %>
              </button>
            </div>

          </div>
        </div>
      </form>
    </main>
  </div>
</div>

<script src="/js/transactions.js"></script>
<script>
  initTransactionForm({
    type: '<%- (transaction ? transaction.type || "expense" : "expense") %>',
    paymentMethod: '<%- (transaction ? transaction.payment_method || "pix" : "pix") %>',
    categoryId: '<%= transaction ? transaction.category_id || "" : "" %>'
  });
</script>
</body>
</html>
