<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('partials/head') %></head>
<body>
<div class="app-layout">
  <%- include('partials/nav') %>

  <div class="main-content">
    <header class="topbar">
      <div class="topbar-title">Configurações</div>
    </header>

    <main class="page-content">
      <% if (success) { %>
        <div class="alert alert-success">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><polyline points="20 6 9 17 4 12"/></svg>
          <%= success %>
        </div>
      <% } %>

      <% if (error) { %>
        <div class="alert alert-error">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
          <%= error %>
        </div>
      <% } %>

      <!-- Perfil do Usuário -->
      <div class="card mb-4">
        <div class="section-header">
          <div>
            <div class="section-title">Meu Perfil</div>
            <div class="section-sub">Atualize suas informações pessoais e credenciais de acesso</div>
          </div>
        </div>

        <div class="grid-2">
          <!-- Dados Básicos -->
          <form action="/settings/profile/update" method="POST" class="add-form">
            <div class="form-label" style="margin-bottom:12px; color:var(--primary)">Informações Pessoais</div>
            <div class="form-group">
              <label class="form-label" for="profile_name">Nome Completo</label>
              <input id="profile_name" type="text" name="name" class="form-control" value="<%= currentUser ? currentUser.name : '' %>" required>
            </div>
            <div class="form-group">
              <label class="form-label" for="profile_email">Endereço de E-mail</label>
              <input id="profile_email" type="email" name="email" class="form-control" value="<%= currentUser ? currentUser.email : '' %>" required>
            </div>
            <button type="submit" class="btn btn-primary btn-sm w-full" style="justify-content:center; margin-top:10px">
              Salvar Dados
            </button>
          </form>

          <!-- Alterar Senha -->
          <form action="/settings/profile/password" method="POST" class="add-form">
            <div class="form-label" style="margin-bottom:12px; color:var(--primary)">Segurança e Senha</div>
            <div class="form-group">
              <label class="form-label" for="current_password">Senha Atual</label>
              <input id="current_password" type="password" name="current_password" class="form-control" placeholder="••••••••" required>
            </div>
            <div class="form-row">
              <div class="form-group" style="margin-bottom:0">
                <label class="form-label" for="new_password">Nova Senha</label>
                <input id="new_password" type="password" name="new_password" class="form-control" placeholder="Mínimo 6 dígitos" required>
              </div>
              <div class="form-group" style="margin-bottom:0">
                <label class="form-label" for="confirm_password">Confirmar Nova Senha</label>
                <input id="confirm_password" type="password" name="confirm_password" class="form-control" placeholder="Repita a senha" required>
              </div>
            </div>
            <button type="submit" class="btn btn-secondary btn-sm w-full" style="justify-content:center; margin-top:14px">
              Alterar Senha
            </button>
          </form>
        </div>
      </div>

      <div class="settings-cols">

        <!-- Column 1: Categorias -->
        <div>
          <div class="card">
            <div class="section-header">
              <div>
                <div class="section-title">Categorias Financeiras</div>
                <div class="section-sub">Personalize as categorias para classificar suas despesas e receitas</div>
              </div>
            </div>

            <!-- Adicionar Categoria Form -->
            <form action="/settings/categories" method="POST" class="add-form">
              <div class="form-label" style="margin-bottom:8px">Adicionar Nova Categoria</div>
              <div class="form-row" style="margin-bottom:10px">
                <div>
                  <input type="text" name="name" class="form-control" placeholder="Nome da categoria" required>
                </div>
                <div style="display:flex; gap:8px">
                  <input type="text" name="icon" class="form-control" style="width:70px; text-align:center" placeholder="🏷️" value="📦">
                  <input type="color" name="color" value="#6366f1" title="Escolha a cor da categoria">
                  <button type="submit" class="btn btn-primary btn-sm" style="flex:1; justify-content:center">Adicionar</button>
                </div>
              </div>
            </form>

            <div class="item-list">
              <% categories.forEach(cat => { %>
                <div class="setting-item">
                  <span class="item-dot" style="background:<%= cat.color %>"></span>
                  <span class="item-icon"><%= cat.icon %></span>
                  <span class="item-name"><%= cat.name %></span>
                  <% if (cat.is_default) { %>
                    <span class="item-badge">Padrão</span>
                  <% } else { %>
                    <div style="display:flex; gap:4px; align-items:center">
                      <!-- Botão Editar Categoria -->
                      <button type="button" class="btn-icon btn-ghost" title="Editar Categoria"
                              onclick="openCategoryEditModal('<%= cat.id %>', '<%= cat.name %>', '<%= cat.icon %>', '<%= cat.color %>')">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                        </svg>
                      </button>
                      <!-- Botão Excluir Categoria -->
                      <form action="/settings/categories/<%= cat.id %>/delete" method="POST" onsubmit="return confirm('Deseja excluir esta categoria personalizada?')">
                        <button type="submit" class="btn-icon" style="background:var(--expense-bg); color:var(--expense); border:none; cursor:pointer" title="Excluir Categoria">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                        </button>
                      </form>
                    </div>
                  <% } %>
                </div>
              <% }) %>
            </div>
          </div>
        </div>

        <!-- Column 2: Instituições Financeiras e Cartões -->
        <div>
          <div class="card">
            <div class="section-header">
              <div>
                <div class="section-title">Contas e Cartões</div>
                <div class="section-sub">Bancos, carteiras digitais e cartões de crédito com controle de limite</div>
              </div>
            </div>

            <!-- Adicionar Instituição Form -->
            <form action="/settings/institutions" method="POST" class="add-form" id="instForm">
              <div class="form-label" style="margin-bottom:8px">Adicionar Instituição ou Cartão</div>
              
              <div class="form-group">
                <input type="text" name="name" class="form-control" placeholder="Nome (Ex: Nubank, Itaú, Inter)" required>
              </div>

              <div class="form-row" style="margin-bottom:10px">
                <div>
                  <label class="form-label">Tipo</label>
                  <select name="type" class="form-control" onchange="toggleLimitField(this.value, 'creditLimitGroup', 'invoiceDaysGroup')">
                    <option value="bank">Banco / Conta Corrente</option>
                    <option value="credit_card">Cartão de Crédito</option>
                    <option value="digital_wallet">Conta Digital</option>
                  </select>
                </div>
                <div>
                  <label class="form-label">Cor</label>
                  <input type="color" name="color" value="#8b5cf6" class="form-control" style="padding:4px; height:42px" title="Cor representativa">
                </div>
              </div>

              <!-- Campos de fatura do cartão -->
              <div class="form-group hidden" id="creditLimitGroup">
                <label class="form-label" for="credit_limit">Limite do Cartão (R$)</label>
                <input type="number" id="credit_limit" name="credit_limit" class="form-control" placeholder="Ex: 5000.00" step="0.01" min="0">
                <div class="form-hint">Usado no Dashboard para alertar caso suas faturas cheguem perto ou estourem o limite.</div>
              </div>

              <div class="form-row hidden" id="invoiceDaysGroup" style="margin-bottom:10px">
                <div>
                  <label class="form-label">Dia de Fechamento</label>
                  <input type="number" name="invoice_closing_day" class="form-control" placeholder="5" min="1" max="31" value="5">
                  <div class="form-hint">Padrão: dia 5</div>
                </div>
                <div>
                  <label class="form-label">Dia de Vencimento</label>
                  <input type="number" name="invoice_due_day" class="form-control" placeholder="10" min="1" max="31" value="10">
                  <div class="form-hint">Padrão: dia 10</div>
                </div>
              </div>

              <button type="submit" class="btn btn-primary btn-sm w-full" style="justify-content:center; margin-top:10px">
                Salvar Instituição
              </button>
            </form>

            <div class="item-list">
              <% if (institutions.length > 0) { %>
                <% institutions.forEach(inst => { 
                  const typeLabel = inst.type === 'credit_card' ? 'Cartão de Crédito' : inst.type === 'bank' ? 'Conta Bancária' : 'Conta Digital';
                %>
                  <div class="setting-item" style="border-left: 3px solid <%= inst.color %>">
                    <span class="item-dot" style="background:<%= inst.color %>"></span>
                    <div style="flex:1">
                      <div class="item-name"><%= inst.name %></div>
                      <div class="text-xs text-muted-c">
                        <%= typeLabel %>
                        <% if (inst.type === 'credit_card' && inst.credit_limit) { %>
                          • Limite: R$ <%= inst.credit_limit.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
                        <% } %>
                      </div>
                    </div>
                    <div style="display:flex; gap:4px; align-items:center">
                      <!-- Botão Editar Instituição -->
                      <button type="button" class="btn-icon btn-ghost" title="Editar Instituição"
                              onclick="openInstEditModal('<%= inst.id %>', '<%= inst.name %>', '<%= inst.type %>', '<%= inst.color %>', '<%= inst.credit_limit || '' %>', '<%= inst.invoice_closing_day || 5 %>', '<%= inst.invoice_due_day || 10 %>')">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                        </svg>
                      </button>
                      <!-- Botão Excluir Instituição -->
                      <form action="/settings/institutions/<%= inst.id %>/delete" method="POST" onsubmit="return confirm('Deseja excluir esta instituição? Suas transações ficarão sem instituição vinculada.')">
                        <button type="submit" class="btn-icon" style="background:var(--expense-bg); color:var(--expense); border:none; cursor:pointer" title="Excluir">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                        </button>
                      </form>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="text-xs text-muted-c text-center py-4">Nenhuma instituição cadastrada ainda. Adicione sua conta ou cartão acima.</div>
              <% } %>
            </div>

          </div>
        </div>

      </div>
    </main>
  </div>
</div>

<!-- Modal Edição de Categoria -->
<div class="modal-overlay" id="categoryEditModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title">Editar Categoria</div>
      <button type="button" class="modal-close" onclick="closeModal('categoryEditModal')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <form id="categoryEditForm" method="POST">
      <div class="form-group">
        <label class="form-label" for="editCatName">Nome da Categoria</label>
        <input type="text" id="editCatName" name="name" class="form-control" required>
      </div>
      <div class="form-row mb-4">
        <div>
          <label class="form-label" for="editCatIcon">Ícone / Emoji</label>
          <input type="text" id="editCatIcon" name="icon" class="form-control" style="text-align:center" required>
        </div>
        <div>
          <label class="form-label" for="editCatColor">Cor</label>
          <input type="color" id="editCatColor" name="color" class="form-control" style="padding:4px; height:42px" required>
        </div>
      </div>
      <div style="display:flex; gap:8px">
        <button type="button" class="btn btn-ghost" style="flex:1; justify-content:center" onclick="closeModal('categoryEditModal')">Cancelar</button>
        <button type="submit" class="btn btn-primary" style="flex:2; justify-content:center">Salvar Alterações</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Edição de Instituição -->
<div class="modal-overlay" id="instEditModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title">Editar Instituição / Cartão</div>
      <button type="button" class="modal-close" onclick="closeModal('instEditModal')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <form id="instEditForm" method="POST">
      <div class="form-group">
        <label class="form-label" for="editInstName">Nome da Instituição</label>
        <input type="text" id="editInstName" name="name" class="form-control" required>
      </div>
      <div class="form-row mb-3">
        <div>
          <label class="form-label" for="editInstType">Tipo</label>
          <select id="editInstType" name="type" class="form-control" onchange="toggleLimitField(this.value, 'editInstLimitGroup')">
            <option value="bank">Banco / Conta Corrente</option>
            <option value="credit_card">Cartão de Crédito</option>
            <option value="digital_wallet">Conta Digital</option>
          </select>
        </div>
        <div>
          <label class="form-label" for="editInstColor">Cor</label>
          <input type="color" id="editInstColor" name="color" class="form-control" style="padding:4px; height:42px" required>
        </div>
      </div>
      <div class="form-group hidden" id="editInstLimitGroup">
        <label class="form-label" for="editInstLimit">Limite do Cartão (R$)</label>
        <input type="number" id="editInstLimit" name="credit_limit" class="form-control" step="0.01" min="0">
      </div>
      <div class="form-row hidden" id="editInstInvoiceDaysGroup" style="margin-bottom:10px">
        <div>
          <label class="form-label">Dia de Fechamento</label>
          <input type="number" id="editInstClosingDay" name="invoice_closing_day" class="form-control" placeholder="5" min="1" max="31">
          <div class="form-hint">Padrão: dia 5</div>
        </div>
        <div>
          <label class="form-label">Dia de Vencimento</label>
          <input type="number" id="editInstDueDay" name="invoice_due_day" class="form-control" placeholder="10" min="1" max="31">
          <div class="form-hint">Padrão: dia 10</div>
        </div>
      </div>
      <div style="display:flex; gap:8px; margin-top:16px">
        <button type="button" class="btn btn-ghost" style="flex:1; justify-content:center" onclick="closeModal('instEditModal')">Cancelar</button>
        <button type="submit" class="btn btn-primary" style="flex:2; justify-content:center">Salvar Alterações</button>
      </div>
    </form>
  </div>
</div>

<script>
  function toggleLimitField(val, limitGroupId, invoiceDaysGroupId) {
    const limitGroup       = document.getElementById(limitGroupId);
    const invoiceDaysGroup = invoiceDaysGroupId ? document.getElementById(invoiceDaysGroupId) : null;
    if (val === 'credit_card') {
      if (limitGroup) limitGroup.classList.remove('hidden');
      if (invoiceDaysGroup) invoiceDaysGroup.classList.remove('hidden');
    } else {
      if (limitGroup) limitGroup.classList.add('hidden');
      if (invoiceDaysGroup) invoiceDaysGroup.classList.add('hidden');
    }
  }

  function openCategoryEditModal(id, name, icon, color) {
    document.getElementById('categoryEditForm').action = `/settings/categories/${id}/update`;
    document.getElementById('editCatName').value = name;
    document.getElementById('editCatIcon').value = icon;
    document.getElementById('editCatColor').value = color;
    document.getElementById('categoryEditModal').classList.add('open');
  }

  function openInstEditModal(id, name, type, color, limit, closingDay, dueDay) {
    document.getElementById('instEditForm').action = `/settings/institutions/${id}/update`;
    document.getElementById('editInstName').value        = name;
    document.getElementById('editInstType').value        = type;
    document.getElementById('editInstColor').value       = color;
    document.getElementById('editInstLimit').value       = limit || '';
    document.getElementById('editInstClosingDay').value  = closingDay || 5;
    document.getElementById('editInstDueDay').value      = dueDay     || 10;
    toggleLimitField(type, 'editInstLimitGroup', 'editInstInvoiceDaysGroup');
    document.getElementById('instEditModal').classList.add('open');
  }

  function closeModal(modalId) {
    document.getElementById(modalId).classList.remove('open');
  }
</script>
</body>
</html>
